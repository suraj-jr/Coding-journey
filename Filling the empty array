import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int[] A = new int[6];
        int[] B = new int[3];

        // First 3 positions of A contain actual values
        A[0] = 1;
        A[1] = 3;
        A[2] = 5;

        System.out.println("Enter B elements:");

        for (int i = 0; i < B.length; i++) {
            B[i] = sc.nextInt();
        }

        int i = 2;              // last actual element in A
        int j = B.length - 1;   // last element in B
        int k = A.length - 1;   // last position in A

        while (j >= 0) {

            if (i >= 0 && A[i] > B[j]) {
                A[k] = A[i];
                i--;
            } else {
                A[k] = B[j];
                j--;
            }

            k--;
        }

        for (int x = 0; x < A.length; x++) {
            System.out.print(A[x] + " ");
        }
    }
}
