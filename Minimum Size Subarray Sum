import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int[] arr = new int[6];
        int n = arr.length;

        System.out.println("enter array elements");

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int target = 7;
        int right = 0, left = 0;
        int sum = 0;
        int min = Integer.MAX_VALUE;
        int count = 0;

        while (right < n) {

            sum += arr[right];
            right++;
            count++;

            while (sum >= target) {

                if (count < min) {
                    min = count;
                }

                sum -= arr[left];
                left++;
                count--;
            }
        }

        System.out.println(min);
    }
}
