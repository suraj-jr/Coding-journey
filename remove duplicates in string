public class Main {
    public static void main(String[] args) {

        String str = "programming";

        char[] arr = str.toCharArray();

        int n = arr.length;
        int i = 1;

        while (i < n) {

            int j = 0;

            while (j < i) {

                if (arr[i] == arr[j]) {

                    int k = i;

                    while (k < n - 1) {
                        arr[k] = arr[k + 1];
                        k++;
                    }

                    n--;
                    break;
                }

                j++;
            }

            i++;
        }

        for (i = 0; i < n; i++) {
            System.out.print(arr[i]);
        }
    }
}n 
