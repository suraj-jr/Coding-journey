import java.util.Scanner;
public class Main{
    public static void main(String [] args){
        Scanner sc= new Scanner(System.in);
        int[] arr= new int[6];
        int n=arr.length;
        System.out.println("enter the array elements");
         for (int i = 0; i < n; i++) {
        arr[i]=sc.nextInt();
    }
    int i=1;
    while(i<n){
        if(arr[i]==arr[i-1]){
            int j=i;
            while(j<n-1){
                  arr[j]=arr[j+1];
                  j++;
            }
            n--;
        }
        
        else{
            i++;
        }
    }
          for (i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
    }
}
